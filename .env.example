# ApexDialer — local configuration
# Copy this file to `.env` and adjust values. Never commit the real .env.
# On Windows: copy .env.example .env

# HTTP port for the backend (3210 avoids common port 3000 conflicts)
PORT=3210

# Demo mode is the default and must stay ON until real calling is explicitly enabled.
# Set to false only during a supervised, approved live test.
APEX_DEMO_MODE=true

# Where the SQLite database lives (defaults to ./data/apexdialer.db)
# APEX_DB_PATH=data/apexdialer.db

# Preliminary calling window in recipient-local time (HH:MM, 24-hour).
# Defaults to 08:00-21:00. This is an internal guardrail, not legal compliance.
# APEX_CALL_WINDOW_START=08:00
# APEX_CALL_WINDOW_END=21:00

# --- Authentication / sessions ---
# Bind address for local use. Keep the default so only this machine can reach the API.
HOST=127.0.0.1

# Session lifetime in hours before the operator must log in again (default 12).
# APEX_SESSION_TTL_HOURS=12

# bcrypt cost factor for password hashing (default 10, range 10-12 recommended).
# APEX_BCRYPT_ROUNDS=10

# Login rate limiting (rolling window).
# APEX_LOGIN_WINDOW_MS=900000
# APEX_LOGIN_MAX_PER_IP=20
# APEX_LOGIN_FAILURE_MAX=5
# APEX_SETUP_WINDOW_MS=3600000
# APEX_SETUP_MAX=10

# Set to true only if the app is served over HTTPS (needed for the Secure cookie flag).
# APEX_COOKIE_SECURE=false