# ApexDialer — local configuration
# Copy this file to `.env` and adjust values. Never commit the real .env.
# On Windows: copy .env.example .env

# HTTP port for the backend (3210 avoids common port 3000 conflicts)
PORT=3210

# Demo mode is the default and must stay ON until real calling is explicitly enabled.
# Set to false only during a supervised, approved live test.
APEX_DEMO_MODE=true

# Where the SQLite database lives (defaults to ./data/apexdialer.db)
# APEX_DB_PATH=data/apexdialer.db

# Preliminary calling window in recipient-local time (HH:MM, 24-hour).
# Defaults to 08:00-21:00. This is an internal guardrail, not legal compliance.
# APEX_CALL_WINDOW_START=08:00
# APEX_CALL_WINDOW_END=21:00

# Power dialer: an in-progress attempt left running longer than this many minutes
# is treated as stale and automatically abandoned on the next check (default 240).
# APEX_MAX_ATTEMPT_MINUTES=240

# --- Authentication / sessions ---
# Bind address for local use. Keep the default so only this machine can reach the API.
HOST=127.0.0.1

# Session lifetime in hours before the operator must log in again (default 12).
# APEX_SESSION_TTL_HOURS=12

# bcrypt cost factor for password hashing (default 10, range 10-12 recommended).
# APEX_BCRYPT_ROUNDS=10

# Login rate limiting (rolling window).
# APEX_LOGIN_WINDOW_MS=900000
# APEX_LOGIN_MAX_PER_IP=20
# APEX_LOGIN_FAILURE_MAX=5
# APEX_SETUP_WINDOW_MS=3600000
# APEX_SETUP_MAX=10

# Set to true only if the app is served over HTTPS (needed for the Secure cookie flag).
# APEX_COOKIE_SECURE=false

# --- Telephony sandbox (provider webhooks) ---
# Disabled by default. This does NOT place real calls: it only enables the
# signed status-callback endpoint used to exercise the call state machine.
# APEX_TWILIO_ENABLED=false
# APEX_TWILIO_PROVIDER=twilio
# Shared secret used to verify the X-Twilio-Signature header (Twilio Auth Token).
# NEVER commit a real value; keep it in .env only.
# APEX_TWILIO_WEBHOOK_SECRET=

# --- Campaign engine (simulated outbound) ---
# Campaigns dial only when an operator starts them AND a tick/runner claims a lead.
# The background runner is OFF by default: with it off, nothing dials on its own.
# APEX_CAMPAIGN_RUNNER=false
# APEX_CAMPAIGN_RUNNER_INTERVAL_MS=15000
# Defaults applied to new campaigns (per-campaign overrides are set in the API/UI).
# APEX_CAMPAIGN_MAX_ATTEMPTS=3
# APEX_CAMPAIGN_RETRY_DELAY_MINUTES=60
# APEX_CAMPAIGN_CONCURRENCY=1
# APEX_CAMPAIGN_PACING_PER_MINUTE=30
# APEX_CAMPAIGN_MAX_CONCURRENCY=5

# --- Compliance / consent gate (fail-closed, enforced in the real dial path) ---
# A real outbound (sales) call requires a campaign compliance profile (business
# identity + AI disclosure + consent basis + operator-declared allowed
# countries) AND a matching granted consent record scoped to (phone, channel,
# purpose). This is an operator assertion, NOT a legal certification, and it is
# NEVER inferred from the lead's phone number. Recording stays off and is
# hardcoded false. Configure profiles/consent via:
#   GET/PUT /api/compliance/campaigns/:id
#   GET/POST /api/compliance/consent , POST /api/compliance/consent/revoke
#   GET     /api/compliance/campaigns/:id/eligibility?leadId=...   (decision preview)
# This gate can be relaxed ONLY in the offline simulator (APEX_DEMO_MODE=true with
# the fake provider and live calling off). In any other mode it is forced on
# regardless of this value. The default is the safe setting.
# APEX_REQUIRE_COMPLIANCE_PROFILE=true

# Transcript/consent retention window in days applied when a profile omits one.
# APEX_TRANSCRIPT_RETENTION_DAYS=30

# --- AI conversation (simulated, offline) ---
# The AI turn engine is a deterministic local intent classifier: it contacts no
# external model, downloads no weights, and processes no audio. Enabling this flag
# does not place calls.
# APEX_AI_ENABLED=false
# APEX_AI_MAX_TURNS=8

# --- Real-time voice dialer (Phase 0: simulated media/agent, offline) ---
# DISABLED by default and never places a real call. Only the in-process "fake"
# provider exists; live telephony is hardcoded off. When enabled, a signed webhook
# endpoint (/api/voice/webhooks/fake) and the authenticated voice-session API become
# available for exercising the conversational state machine with NO carrier and NO
# audio.
# APEX_VOICE_ENABLED=false
# APEX_VOICE_PROVIDER=fake
# Agent script inputs (template text only; the agent invents no facts):
# APEX_VOICE_BUSINESS_NAME=ApexDialer Demo
# APEX_VOICE_PURPOSE=follow up on your recent inquiry
# Public https origin that providers call (e.g. https://apex.example.com). Webhook
# signatures are verified against this origin, not the request Host header, so set
# it whenever the app sits behind a proxy or tunnel. Origin only: no path or query.
# APEX_PUBLIC_BASE_URL=

# GPT-Live (OpenAI primary WebSocket) settings. Inert until a live adapter is
# deliberately enabled. The backend model has NO default and must be chosen by you.
# APEX_VOICE_LIVE_MODEL=gpt-live-1
# APEX_VOICE_LIVE_VOICE=marin
# APEX_VOICE_LIVE_BACKEND_MODEL=

# Outbound caller ID (E.164) for a future live adapter. Not used by the fake provider.
# APEX_VOICE_FROM_NUMBER=
# Destination for transfer requests (E.164). Distinct from the caller ID above.
# APEX_VOICE_TRANSFER_NUMBER=
# Conversation bounds:
# APEX_VOICE_MAX_TURNS=8
# APEX_VOICE_MAX_SILENCE_RETRIES=2
# APEX_VOICE_MAX_INVALID=2
# Bounds for the auditable AI tool loop: max model tool calls per call and a hard
# per-call duration cap (seconds). The server re-validates every model tool call.
# APEX_VOICE_MAX_TOOL_CALLS=12
# APEX_VOICE_MAX_CALL_SECONDS=600
# AI disclosure spoken to the recipient; also the realtime model's instructions.
# APEX_VOICE_AI_DISCLOSURE=This call is handled by an automated assistant.
# Real-time model/voice names for the (unregistered) real adapters. Inert until a
# live transport stack is deliberately wired; they cannot enable any network use.
# APEX_VOICE_REALTIME_MODEL=gpt-realtime
# APEX_VOICE_REALTIME_VOICE=alloy
# Shared secret used to verify the X-Apex-Voice-Signature header (HMAC-SHA256).
# Required when the voice sandbox is enabled. NEVER commit a real value.
# APEX_VOICE_WEBHOOK_SECRET=
# The dialer is built against five swappable capability interfaces (telephony,
# audio streaming, STT, TTS, conversation). Only offline "fake" adapters ship, and
# live telephony is forced off in config. Selecting a real provider (e.g. twilio)
# requires real credentials AND a deliberate code change; until then selection
# fails closed. Required real-provider keys (names only; keep them out of git):
#   APEX_TWILIO_ACCOUNT_SID / APEX_TWILIO_AUTH_TOKEN / APEX_TWILIO_FROM_NUMBER