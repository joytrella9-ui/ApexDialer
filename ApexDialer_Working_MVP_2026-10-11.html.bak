<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ApexDialer — Call Center Workspace</title>
<style>
:root{color-scheme:dark;--bg:#090e19;--panel:#111a2a;--panel2:#172337;--line:#26364d;--muted:#8ea1bb;--text:#e8eff8;--cyan:#41c8e8;--green:#43d6a0;--amber:#f5bd58;--red:#ff7285;--purple:#b6a0ff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% -10%,#172d48 0,transparent 42%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}button:disabled{opacity:.4;cursor:not-allowed}.app{min-height:100vh;display:grid;grid-template-columns:230px minmax(0,1fr)}aside{border-right:1px solid var(--line);background:#0b1220;padding:22px 14px;display:flex;flex-direction:column;gap:25px}.brand{display:flex;gap:11px;align-items:center;padding:0 8px}.logo{width:38px;height:38px;border-radius:12px;background:linear-gradient(145deg,#52d5ed,#3978df);display:grid;place-items:center;color:#071321;font-weight:900;font-size:20px}.brand strong{display:block;font-size:15px;letter-spacing:.04em}.brand small{color:var(--muted);font-size:11px}.navlabel{color:#657992;font-size:10px;font-weight:800;letter-spacing:.16em;padding:0 12px}.nav{display:grid;gap:5px}.nav button{border:1px solid transparent;background:transparent;color:#9eb0c7;text-align:left;padding:11px 12px;border-radius:10px;display:flex;gap:11px;align-items:center}.nav button.active,.nav button:hover{background:#15283b;border-color:#254259;color:#eafaff}.nav .ico{width:18px;text-align:center;color:var(--cyan)}.sidefoot{margin-top:auto;background:#101b2b;border:1px solid var(--line);padding:13px;border-radius:12px}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:7px}.sidefoot small{color:var(--muted);display:block;margin-top:5px;font-size:11px}.main{min-width:0}.topbar{height:74px;padding:0 28px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:15px;background:#0b1220cc;position:sticky;top:0;z-index:5;backdrop-filter:blur(14px)}.crumb{color:var(--muted);font-size:12px}.topbar h1{font-size:19px;margin:2px 0 0}.topactions{display:flex;gap:9px;align-items:center}.avatar{height:34px;width:34px;border-radius:50%;display:grid;place-items:center;background:#243957;color:#b9eafa;font-weight:800}.content{padding:25px 28px 40px;max-width:1700px;margin:auto}.page{display:none}.page.active{display:block}.sectionhead{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:19px}.sectionhead h2{margin:0;font-size:23px;letter-spacing:-.03em}.sub{color:var(--muted);margin-top:4px;font-size:12px}.btn{border:1px solid #344760;background:#172337;color:#e5effa;border-radius:9px;padding:9px 13px;font-weight:650;display:inline-flex;align-items:center;justify-content:center;gap:7px}.btn:hover{filter:brightness(1.13)}.btn.primary{background:linear-gradient(135deg,#26b6d7,#3c8ee8);color:#061522;border-color:transparent}.btn.success{background:#103c34;border-color:#1b725f;color:#72edc3}.btn.danger{background:#401d2a;border-color:#713245;color:#ff9aa8}.btn.ghost{background:transparent}.btn.small{padding:6px 9px;font-size:12px}.grid{display:grid;gap:15px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:17px}.card{background:linear-gradient(150deg,#141f31,#0f1827);border:1px solid var(--line);border-radius:15px;padding:18px;min-width:0;box-shadow:0 12px 30px #00000012}.statlabel{color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:8px}.statvalue{font-size:28px;font-weight:800;letter-spacing:-.04em;margin-top:8px}.statnote{font-size:11px;color:#8094ae;margin-top:4px}.staticon{color:var(--cyan);font-size:18px}.workspace{grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);align-items:start}.cardhead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}.cardhead h3{font-size:14px;margin:0}.pill{font-size:10px;letter-spacing:.06em;text-transform:uppercase;padding:4px 8px;border-radius:99px;background:#153b35;color:#6be3ba;font-weight:800}.pill.warn{background:#3b301c;color:#ffd27b}.pill.red{background:#401d2a;color:#ff9cab}.muted{color:var(--muted)}.callbox{background:radial-gradient(ellipse at 50% 0,#1a3b54,#111a2a 68%);border:1px solid #29465e;border-radius:12px;padding:20px;text-align:center}.callring{width:68px;height:68px;border-radius:50%;border:1px solid #2b6c85;background:#102e43;color:#69d9f1;display:grid;place-items:center;font-size:27px;margin:3px auto 12px}.callbox h3{margin:0;font-size:17px}.callbox p{color:var(--muted);font-size:12px;margin:4px 0 14px}.calltime{font-size:25px;font-variant-numeric:tabular-nums;font-weight:750;margin:7px 0 14px}.callcontrols{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}.formrow{display:flex;gap:8px}.field{display:grid;gap:6px;margin-bottom:12px;min-width:0}.field label{font-size:11px;color:#9fb2ca;font-weight:700}.field input,.field select,.field textarea,.search{width:100%;min-width:0;background:#0b1422;border:1px solid #2b3c53;border-radius:8px;color:var(--text);padding:10px 11px}.field textarea{resize:vertical;min-height:84px}.field input::placeholder,.search::placeholder{color:#62748b}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:11px}table{width:100%;border-collapse:collapse;white-space:nowrap}th{background:#111d2d;color:#8197b3;text-align:left;font-size:10px;letter-spacing:.09em;text-transform:uppercase;padding:12px}td{padding:12px;border-top:1px solid #1f2d41;font-size:12px}tbody tr:hover{background:#17253a}td.name{font-weight:750;color:#e7f1fd}.badge{display:inline-flex;align-items:center;gap:5px;border-radius:6px;padding:4px 7px;font-size:10px;font-weight:750;background:#1b2b40;color:#b8cae0}.badge.pending{color:#ffd37e;background:#352c1d}.badge.completed{color:#7fe3b9;background:#16372f}.badge.dnc{color:#ff9eac;background:#411e2b}.filters{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.filters .search{flex:1;min-width:180px}.filters select{background:#0b1422;border:1px solid #2b3c53;color:var(--text);border-radius:8px;padding:10px}.tablefoot{display:flex;justify-content:space-between;align-items:center;gap:10px;color:var(--muted);font-size:11px;margin-top:12px}.log{display:grid;gap:8px;max-height:270px;overflow:auto}.logitem{display:flex;gap:10px;padding:9px 10px;background:#0c1523;border-radius:8px;border:1px solid #1e2c40;font-size:12px}.logtime{color:#758ba6;font:11px ui-monospace,monospace;white-space:nowrap}.logmsg{overflow-wrap:anywhere}.empty{padding:30px;text-align:center;color:var(--muted)}.two{grid-template-columns:1fr 1fr}.three{grid-template-columns:repeat(3,1fr)}.notice{border:1px solid #5d4b26;background:#2a2417;color:#f3d28c;border-radius:10px;padding:11px 13px;font-size:12px;margin-bottom:15px}.modalback{position:fixed;inset:0;background:#020711c9;z-index:20;display:none;align-items:center;justify-content:center;padding:18px}.modalback.open{display:flex}.modal{width:min(540px,100%);background:#111b2b;border:1px solid #344860;border-radius:16px;padding:22px;box-shadow:0 25px 90px #0009;max-height:90vh;overflow:auto}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.modalhead h3{margin:0}.toastarea{position:fixed;right:18px;bottom:18px;z-index:40;display:grid;gap:8px;width:min(360px,calc(100vw - 36px))}.toast{background:#16263a;border:1px solid #38526c;padding:12px 14px;border-radius:10px;box-shadow:0 8px 30px #0006;font-size:12px}.toast.error{border-color:#874052}.toast.ok{border-color:#28745e}.bar{height:7px;background:#223249;border-radius:99px;overflow:hidden}.bar span{height:100%;display:block;background:linear-gradient(90deg,#36c7df,#638cf4);border-radius:99px}.hidden{display:none!important}.mobile-nav{display:none}
@media(max-width:1100px){.app{grid-template-columns:76px minmax(0,1fr)}aside{padding:20px 9px}.brand{justify-content:center;padding:0}.brandtext,.navlabel,.navtext,.sidefoot{display:none}.nav button{justify-content:center;padding:12px 5px;font-size:17px}.workspace{grid-template-columns:1fr}.content{padding:20px}.topbar{padding:0 20px}}
@media(max-width:720px){.app{display:block}aside{display:none}.content{padding-bottom:92px}.mobile-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;position:fixed;left:0;right:0;bottom:0;z-index:10;padding:8px max(8px,env(safe-area-inset-left)) calc(8px + env(safe-area-inset-bottom));background:#0b1220f2;border-top:1px solid var(--line);backdrop-filter:blur(14px)}.mobile-nav button{border:1px solid transparent;background:transparent;color:#9eb0c7;border-radius:8px;padding:7px 2px;font-size:10px;display:grid;justify-items:center;gap:3px}.mobile-nav button .ico{font-size:16px;color:var(--cyan)}.mobile-nav button.active{background:#15283b;border-color:#254259;color:#eafaff}.topbar{height:auto;min-height:68px;padding:12px 15px}.topbar h1{font-size:16px}.content{padding:16px 12px 28px}.stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{padding:14px}.statvalue{font-size:24px}.sectionhead{flex-direction:column}.two,.three{grid-template-columns:1fr}.topactions .hide-mobile{display:none}.formrow{flex-direction:column}.tablefoot{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<div class="app">
<aside>
  <div class="brand"><div class="logo">A</div><div class="brandtext"><strong>APEXDIALER</strong><small>CALL CENTER WORKSPACE</small></div></div>
  <div><div class="navlabel">WORKSPACE</div><nav class="nav" aria-label="Main navigation">
    <button class="active" data-page="overview"><span class="ico">◫</span><span class="navtext">Overview</span></button>
    <button data-page="leads"><span class="ico">♙</span><span class="navtext">Lead queue</span></button>
    <button data-page="dialer"><span class="ico">☎</span><span class="navtext">Dialer</span></button>
    <button data-page="activity"><span class="ico">☷</span><span class="navtext">Activity log</span></button>
    <button data-page="settings"><span class="ico">⚙</span><span class="navtext">Settings & data</span></button>
  </nav></div>
  <div class="sidefoot"><span class="dot"></span><strong>Local demo mode</strong><small>Saved in this browser. No carrier is connected.</small></div>
</aside>
<div class="main">
<header class="topbar"><div><div class="crumb">APEXDIALER / <span id="crumb">OVERVIEW</span></div><h1 id="pageTitle">Call center overview</h1></div><div class="topactions"><button class="btn ghost hide-mobile" id="exportTop">⇩ Export CSV</button><button class="btn primary" id="addTop">＋ Add lead</button><div class="avatar" title="Local operator">OP</div></div></header>
<main class="content">
<section class="page active" id="page-overview">
 <div class="sectionhead"><div><h2>Good work starts with a clear queue.</h2><div class="sub">Your campaign snapshot, calling workspace, and next best action.</div></div><button class="btn" data-goto="leads">View lead queue →</button></div>
 <div class="notice">Demo mode: call actions simulate outcomes locally. This page does not connect to a phone carrier, place real calls, or provide live AI. Use only contacts you are authorized to call.</div>
 <div class="grid stats">
  <div class="card"><div class="statlabel">Total leads <span class="staticon">♙</span></div><div class="statvalue" id="statTotal">0</div><div class="statnote">Contacts in this workspace</div></div>
  <div class="card"><div class="statlabel">Ready to call <span class="staticon">↗</span></div><div class="statvalue" id="statPending">0</div><div class="statnote">Excludes completed and DNC</div></div>
  <div class="card"><div class="statlabel">Completed <span class="staticon">✓</span></div><div class="statvalue" id="statCompleted">0</div><div class="statnote">Disposition recorded</div></div>
  <div class="card"><div class="statlabel">Do not call <span class="staticon">⊘</span></div><div class="statvalue" id="statDnc">0</div><div class="statnote">Suppressed from dialing</div></div>
 </div>
 <div class="grid workspace">
  <div class="card"><div class="cardhead"><h3>Lead queue preview</h3><button class="btn small" data-goto="leads">Manage leads →</button></div><div id="overviewLeads"></div></div>
  <div class="card"><div class="cardhead"><h3>Dialer control</h3><span class="pill warn" id="callModeBadge">DEMO MODE</span></div>
   <div class="callbox"><div class="callring">☎</div><h3 id="activeName">No active contact</h3><p id="activePhone">Choose a lead to begin a demo call</p><div class="calltime" id="callTimer">00:00</div><div class="callcontrols"><button class="btn primary" id="startNext">▶ Start next</button><button class="btn danger" id="endCall" disabled>■ End call</button></div></div>
   <div class="field" style="margin-top:15px"><label for="manualPhone">Manual number (demo only)</label><div class="formrow"><input id="manualPhone" placeholder="+1 555 010 1234" inputmode="tel"><button class="btn" id="manualCall">Call</button></div></div>
   <div class="sub">Call controls update the local demo state only.</div>
  </div>
 </div>
 <div class="grid two" style="margin-top:15px"><div class="card"><div class="cardhead"><h3>Campaign completion</h3><span id="completionText" class="muted">0%</span></div><div class="bar"><span id="completionBar" style="width:0%"></span></div><div class="sub" style="margin-top:10px">Completed leads / all eligible leads</div></div><div class="card"><div class="cardhead"><h3>Recent activity</h3><button class="btn small" data-goto="activity">Open log →</button></div><div id="recentLogs" class="log"></div></div></div>
</section>
<section class="page" id="page-leads">
 <div class="sectionhead"><div><h2>Lead queue</h2><div class="sub">Import, search, update, and suppress contacts from your local workspace.</div></div><div class="formrow"><button class="btn" id="importBtn">⇧ Import CSV</button><button class="btn primary" id="addLeadBtn">＋ Add lead</button><input class="hidden" id="csvFile" type="file" accept=".csv,text/csv"></div></div>
 <div class="card"><div class="filters"><input class="search" id="leadSearch" placeholder="Search name, phone, company or ID…" aria-label="Search leads"><select id="statusFilter" aria-label="Filter by status"><option value="all">All statuses</option><option>Pending</option><option>Completed</option><option>DNC</option></select><button class="btn" id="exportLeads">⇩ Export CSV</button></div><div class="tablewrap" id="leadTable"></div><div class="tablefoot"><span id="leadCount">0 leads</span><span>Tip: DNC contacts stay suppressed when resetting the queue.</span></div></div>
</section>
<section class="page" id="page-dialer">
 <div class="sectionhead"><div><h2>Dialer</h2><div class="sub">A safe local simulation of a single-contact calling workflow.</div></div><span class="pill warn">NOT CONNECTED TO TELEPHONY</span></div>
 <div class="notice">To make real calls, this app needs a telephony provider, a secure backend, authentication, and jurisdiction-specific compliance checks. Never put provider secrets in this HTML file.</div>
 <div class="grid workspace"><div class="card"><div class="cardhead"><h3>Current contact</h3><span class="pill" id="dialStatus">IDLE</span></div><div class="callbox"><div class="callring">☎</div><h3 id="dialName">No active contact</h3><p id="dialPhone">Select a lead from the queue</p><div class="calltime" id="dialTimer">00:00</div><div class="callcontrols"><button class="btn primary" id="dialStartNext">▶ Start next lead</button><button class="btn danger" id="dialEnd" disabled>■ End call</button></div></div><div class="grid two" style="margin-top:15px"><button class="btn" data-disposition="No answer">No answer</button><button class="btn" data-disposition="Voicemail">Voicemail</button><button class="btn success" data-disposition="Interested">Interested</button><button class="btn danger" data-disposition="Add to DNC">Add to DNC</button></div></div><div class="card"><div class="cardhead"><h3>Call notes</h3><span class="muted">Saved locally</span></div><div class="field"><label for="callNotes">Notes for active contact</label><textarea id="callNotes" placeholder="Record outcome, follow-up date, or context…"></textarea></div><button class="btn primary" id="saveNotes">Save notes</button><hr style="border-color:var(--line);margin:20px 0"><div class="field"><label for="dialManual">Manual number</label><input id="dialManual" placeholder="+1 555 010 1234" inputmode="tel"></div><button class="btn" id="dialManualBtn">Start demo call</button></div></div>
</section>
<section class="page" id="page-activity">
 <div class="sectionhead"><div><h2>Activity log</h2><div class="sub">Recent local actions and demo call events.</div></div><button class="btn" id="clearLogs">Clear log</button></div>
 <div class="card"><div id="allLogs" class="log"></div></div>
</section>
<section class="page" id="page-settings">
 <div class="sectionhead"><div><h2>Settings & data</h2><div class="sub">Manage this browser's workspace data.</div></div></div>
 <div class="grid two"><div class="card"><div class="cardhead"><h3>Workspace data</h3></div><p class="muted">Lead records are stored in this browser using local storage. They are not synced to a team or server.</p><div class="callcontrols" style="justify-content:flex-start"><button class="btn" id="exportSettings">Export backup CSV</button><button class="btn" id="resetQueue">Reset eligible lead statuses</button></div><p class="sub">Reset leaves Do Not Call records untouched.</p></div><div class="card"><div class="cardhead"><h3>Production checklist</h3></div><ul class="muted" style="padding-left:18px;display:grid;gap:9px"><li>Secure sign-in and role permissions</li><li>Server-side database and audit trail</li><li>Telephony provider integration and verified call events</li><li>Consent, suppression lists, and allowed calling hours</li><li>Secure AI service integration with API keys held server-side</li><li>Backups, monitoring, and browser/device testing</li></ul></div></div>
</section>
</main><nav class="mobile-nav" aria-label="Mobile navigation">
<button class="active" data-page="overview"><span class="ico">◫</span><span>Home</span></button>
<button data-page="leads"><span class="ico">♙</span><span>Leads</span></button>
<button data-page="dialer"><span class="ico">☎</span><span>Dialer</span></button>
<button data-page="activity"><span class="ico">☷</span><span>Activity</span></button>
<button data-page="settings"><span class="ico">⚙</span><span>Settings</span></button>
</nav></div></div>
<div class="modalback" id="leadModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal"><div class="modalhead"><h3 id="modalTitle">Add lead</h3><button class="btn small" id="closeModal" aria-label="Close">✕</button></div><form id="leadForm"><input type="hidden" id="editId"><div class="grid two"><div class="field"><label for="leadName">Full name *</label><input id="leadName" required maxlength="120" autocomplete="name"></div><div class="field"><label for="leadPhone">Phone number *</label><input id="leadPhone" required inputmode="tel" maxlength="40" placeholder="+1 555 010 1234"></div><div class="field"><label for="leadCompany">Company</label><input id="leadCompany" maxlength="120" autocomplete="organization"></div><div class="field"><label for="leadStatus">Status</label><select id="leadStatus"><option>Pending</option><option>Completed</option><option>DNC</option></select></div></div><div class="field"><label for="leadNotes">Notes</label><textarea id="leadNotes" maxlength="4000"></textarea></div><div class="callcontrols" style="justify-content:flex-end"><button type="button" class="btn" id="cancelModal">Cancel</button><button class="btn primary" type="submit">Save lead</button></div></form></div></div>
<div class="toastarea" id="toastArea" aria-live="polite"></div>
<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);
const DEFAULTS = [
 {id:'APX-1001',name:'Jordan Mitchell',phone:'+1 555 010 1001',company:'Northstar Logistics',status:'Pending',disposition:'—',notes:''},
 {id:'APX-1002',name:'Taylor Brooks',phone:'+1 555 010 1002',company:'Bluepeak Systems',status:'Pending',disposition:'—',notes:''},
 {id:'APX-1003',name:'Morgan Ellis',phone:'+1 555 010 1003',company:'Cedarline Group',status:'Pending',disposition:'—',notes:''},
 {id:'APX-1004',name:'Casey Bennett',phone:'+1 555 010 1004',company:'Summit Works',status:'Pending',disposition:'—',notes:''},
 {id:'APX-1005',name:'Riley Carter',phone:'+1 555 010 1005',company:'Harbor & Field',status:'Pending',disposition:'—',notes:''}
];
let leads = loadLeads(), logs = loadLogs(), activeLeadId = null, callStart = null, callTicker = null, callSeconds = 0;
const titles = {overview:'Call center overview',leads:'Lead queue',dialer:'Dialer workspace',activity:'Activity log','settings':'Settings & data'};
function loadLeads(){try{const v=JSON.parse(localStorage.getItem('apex_workspace_leads')||'null');return Array.isArray(v)?v.filter(x=>x&&x.id&&x.name&&x.phone).map(x=>({...x,status:['Pending','Completed','DNC'].includes(x.status)?x.status:'Pending',company:String(x.company||''),notes:String(x.notes||''),disposition:String(x.disposition||'—')})):DEFAULTS.map(x=>({...x}));}catch{return DEFAULTS.map(x=>({...x}));}}
function loadLogs(){try{const v=JSON.parse(localStorage.getItem('apex_workspace_logs')||'[]');return Array.isArray(v)?v.slice(0,200):[]}catch{return [];}}
function persist(){try{localStorage.setItem('apex_workspace_leads',JSON.stringify(leads));localStorage.setItem('apex_workspace_logs',JSON.stringify(logs.slice(0,200)));}catch{toast('Browser storage unavailable. Export a backup to avoid losing changes.','error');}}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function toast(msg,type='ok'){const el=document.createElement('div');el.className='toast '+type;el.textContent=msg;$('toastArea').append(el);setTimeout(()=>el.remove(),3600);}
function log(msg,type='info'){logs.unshift({time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'}),msg:String(msg),type});logs=logs.slice(0,200);persist();renderLogs();renderRecent();}
function uid(){return 'APX-'+Date.now().toString(36).toUpperCase()+'-'+Math.random().toString(36).slice(2,6).toUpperCase();}
function digits(phone){return String(phone).replace(/\D/g,'');}
function validPhone(phone){return /^[+0-9().\s-]+$/.test(phone.trim())&&digits(phone).length>=7&&digits(phone).length<=15;}
function badge(status){const cls=status==='DNC'?'dnc':status==='Completed'?'completed':'pending';return `<span class="badge ${cls}">${status==='DNC'?'Do not call':esc(status)}</span>`;}
function leadRows(list, compact=false){if(!list.length)return '<div class="empty">No leads match. Add a contact or change your filters.</div>';return `<table><thead><tr><th>Contact</th><th>Company</th><th>Status</th>${compact?'':'<th>Last outcome</th><th>Actions</th>'}</tr></thead><tbody>${list.map(l=>`<tr><td><div class="name">${esc(l.name)}</div><div class="muted">${esc(l.phone)}</div></td><td>${esc(l.company||'—')}</td><td>${badge(l.status)}</td>${compact?'':`<td>${esc(l.disposition||'—')}</td><td><div class="formrow"><button class="btn small" data-action="call" data-id="${esc(l.id)}" ${l.status==='DNC'||activeLeadId?'disabled':''}>Call</button><button class="btn small" data-action="edit" data-id="${esc(l.id)}">Edit</button><button class="btn small danger" data-action="delete" data-id="${esc(l.id)}" ${l.id===activeLeadId?'disabled':''}>×</button></div></td>`}</tr>`).join('')}</tbody></table>`;}
function render(){const pending=leads.filter(l=>l.status==='Pending'),done=leads.filter(l=>l.status==='Completed'),dnc=leads.filter(l=>l.status==='DNC');$('statTotal').textContent=leads.length;$('statPending').textContent=pending.length;$('statCompleted').textContent=done.length;$('statDnc').textContent=dnc.length;$('overviewLeads').innerHTML=leadRows(leads.filter(l=>l.status==='Pending').slice(0,5),true);const eligible=leads.filter(l=>l.status!=='DNC');const pct=eligible.length?Math.round(done.length/eligible.length*100):0;$('completionText').textContent=pct+'%';$('completionBar').style.width=pct+'%';renderTable();renderLogs();renderRecent();syncCallUI();}
function renderTable(){const q=$('leadSearch').value.trim().toLowerCase(),st=$('statusFilter').value;const list=leads.filter(l=>(st==='all'||l.status===st)&&[l.id,l.name,l.phone,l.company].some(v=>String(v||'').toLowerCase().includes(q)));$('leadTable').innerHTML=leadRows(list);$('leadCount').textContent=`${list.length} of ${leads.length} leads`;}
function renderLogs(){const make=()=>logs.length?logs.map(x=>`<div class="logitem"><span class="logtime">${esc(x.time)}</span><span class="logmsg">${esc(x.msg)}</span></div>`).join(''):'<div class="empty">No activity yet.</div>';$('allLogs').innerHTML=make();}
function renderRecent(){$('recentLogs').innerHTML=logs.slice(0,4).map(x=>`<div class="logitem"><span class="logtime">${esc(x.time)}</span><span class="logmsg">${esc(x.msg)}</span></div>`).join('')||'<div class="empty">Your activity will appear here.</div>';}
function showPage(name){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+name));document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===name));$('pageTitle').textContent=titles[name]||titles.overview;$('crumb').textContent=name.toUpperCase();if(name==='leads')renderTable();}
function openModal(lead=null){$('leadForm').reset();$('editId').value=lead?.id||'';$('modalTitle').textContent=lead?'Edit lead':'Add lead';if(lead){$('leadName').value=lead.name;$('leadPhone').value=lead.phone;$('leadCompany').value=lead.company||'';$('leadStatus').value=lead.status;$('leadNotes').value=lead.notes||'';}else $('leadStatus').value='Pending';$('leadModal').classList.add('open');$('leadName').focus();}
function closeModal(){$('leadModal').classList.remove('open');}
function saveLead(e){e.preventDefault();const id=$('editId').value,name=$('leadName').value.trim(),phone=$('leadPhone').value.trim(),company=$('leadCompany').value.trim(),status=$('leadStatus').value,notes=$('leadNotes').value.trim();if(!name){toast('Enter the contact name.','error');return;}if(!validPhone(phone)){toast('Enter a valid phone number with 7–15 digits.','error');return;}if(id){const l=leads.find(x=>x.id===id);if(!l)return;if(id===activeLeadId&&status==='DNC'){toast('End the active call before marking this contact DNC.','error');return;}Object.assign(l,{name,phone,company,status,notes});log(`Updated lead: ${name}`);}else{leads.unshift({id:uid(),name,phone,company,status,notes,disposition:'—'});log(`Added lead: ${name}`);}persist();closeModal();render();toast('Lead saved.');}
function startCall(lead){if(activeLeadId){toast('End the active call first.','error');return;}if(!lead){toast('No eligible leads are ready.','error');return;}if(lead.status==='DNC'){toast('This contact is on the Do Not Call list.','error');return;}activeLeadId=lead.id;callStart=Date.now();callSeconds=0;lead.disposition='In demo call';$('callNotes').value=lead.notes||'';clearInterval(callTicker);callTicker=setInterval(()=>{callSeconds=Math.floor((Date.now()-callStart)/1000);syncCallUI();},1000);log(`Demo call started for ${lead.name}. No real call was placed.`);render();showPage('dialer');}
function startNext(){startCall(leads.find(l=>l.status==='Pending'));}
function endCall(disposition='Completed'){if(!activeLeadId)return;const lead=leads.find(l=>l.id===activeLeadId);if(!lead)return;const duration=callSeconds;lead.status=disposition==='Add to DNC'?'DNC':'Completed';lead.disposition=disposition==='Completed'?'Completed':disposition;log(`Demo call ended: ${lead.name} · ${disposition} · ${formatTime(duration)}. No carrier was connected.`);activeLeadId=null;callStart=null;callSeconds=0;clearInterval(callTicker);callTicker=null;persist();render();toast(disposition==='Add to DNC'?'Contact added to Do Not Call suppression.':'Call outcome saved.');}
function formatTime(sec){return String(Math.floor(sec/60)).padStart(2,'0')+':'+String(sec%60).padStart(2,'0');}
function syncCallUI(){const l=leads.find(x=>x.id===activeLeadId),time=formatTime(callSeconds);['callTimer','dialTimer'].forEach(id=>$(id).textContent=time);['activeName','dialName'].forEach(id=>$(id).textContent=l?l.name:'No active contact');['activePhone','dialPhone'].forEach(id=>$(id).textContent=l?l.phone:'Choose a lead to begin a demo call');['endCall','dialEnd'].forEach(id=>$(id).disabled=!l);['startNext','dialStartNext','manualCall','dialManualBtn'].forEach(id=>$(id).disabled=!!l);$('dialStatus').textContent=l?'SIMULATED CALL':'IDLE';document.querySelectorAll('[data-disposition]').forEach(b=>b.disabled=!l);renderTable();}
function manualCall(inputId){const phone=$(inputId).value.trim();if(!validPhone(phone)){toast('Enter a valid phone number with 7–15 digits.','error');return;}if(activeLeadId){toast('End the active call first.','error');return;}const lead={id:uid(),name:'Manual contact',phone,company:'Manual dial',status:'Pending',disposition:'—',notes:''};leads.unshift(lead);persist();log('Created manual demo contact.');startCall(lead);}
function csvParse(text){const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i];if(quoted){if(c==='"'&&text[i+1]==='"'){cell+='"';i++;}else if(c==='"')quoted=false;else cell+=c;}else if(c==='"')quoted=true;else if(c===','){row.push(cell);cell='';}else if(c==='\n'){row.push(cell.replace(/\r$/,''));rows.push(row);row=[];cell='';}else cell+=c;}if(cell.length||row.length){row.push(cell.replace(/\r$/,''));rows.push(row);}return rows;}
function importCSV(text){const rows=csvParse(text);let added=0,skipped=0;rows.forEach((r,i)=>{if(!r.some(v=>v.trim()))return;const vals=r.map(v=>v.trim());if(i===0&&/name/i.test(vals[0])&&/phone/i.test(vals[1]||''))return;const [name,phone,company='Enterprise']=vals;if(!name||!validPhone(phone||'')){skipped++;return;}leads.push({id:uid(),name,phone,company,status:'Pending',disposition:'—',notes:''});added++;});persist();render();log(`CSV import finished: ${added} added, ${skipped} skipped.`);toast(`${added} imported · ${skipped} skipped`);}
function csvCell(v){let s=String(v??'');if(/^[=+\-@\t\r]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"';}
function exportCSV(){const rows=[['Lead ID','Name','Phone','Company','Status','Disposition','Notes'],...leads.map(l=>[l.id,l.name,l.phone,l.company,l.status,l.disposition,l.notes])];const blob=new Blob([rows.map(r=>r.map(csvCell).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8;'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='apexdialer-leads.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);log('Lead CSV exported.');}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));document.querySelectorAll('[data-goto]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.goto)));
$('addTop').onclick=$('addLeadBtn').onclick=()=>openModal();$('closeModal').onclick=$('cancelModal').onclick=closeModal;$('leadForm').addEventListener('submit',saveLead);$('leadSearch').addEventListener('input',renderTable);$('statusFilter').addEventListener('change',renderTable);
$('importBtn').onclick=()=>$('csvFile').click();$('csvFile').addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;try{importCSV(await file.text());}catch{toast('Could not read that CSV file.','error');}e.target.value='';});
$('exportTop').onclick=$('exportLeads').onclick=$('exportSettings').onclick=exportCSV;
$('startNext').onclick=$('dialStartNext').onclick=startNext;$('endCall').onclick=$('dialEnd').onclick=()=>endCall('Completed');$('manualCall').onclick=()=>manualCall('manualPhone');$('dialManualBtn').onclick=()=>manualCall('dialManual');
$('saveNotes').onclick=()=>{const l=leads.find(x=>x.id===activeLeadId);if(!l){toast('Start a demo call to attach notes.','error');return;}l.notes=$('callNotes').value;persist();log(`Notes saved for ${l.name}.`);toast('Notes saved.');};
document.querySelectorAll('[data-disposition]').forEach(b=>b.addEventListener('click',()=>{if(!activeLeadId)return;const d=b.dataset.disposition;const l=leads.find(x=>x.id===activeLeadId);if(l&&$('callNotes').value.trim())l.notes=$('callNotes').value.trim();endCall(d);}));
$('leadTable').addEventListener('click',e=>{const b=e.target.closest('button[data-action]');if(!b)return;const l=leads.find(x=>x.id===b.dataset.id);if(!l)return;if(b.dataset.action==='call')startCall(l);if(b.dataset.action==='edit')openModal(l);if(b.dataset.action==='delete'){if(l.id===activeLeadId){toast('End the active call before deleting this contact.','error');return;}if(confirm(`Delete ${l.name} from this browser workspace?`)){leads=leads.filter(x=>x.id!==l.id);persist();log(`Deleted lead: ${l.name}`);render();}}});
$('resetQueue').onclick=()=>{if(!confirm('Reset all non-DNC lead statuses to Pending?'))return;leads.forEach(l=>{if(l.status!=='DNC')l.status='Pending';if(l.status!=='DNC')l.disposition='—';});persist();log('Reset eligible leads; DNC records preserved.');render();toast('Eligible leads reset.');};
$('clearLogs').onclick=()=>{if(confirm('Clear activity history?')){logs=[];persist();renderLogs();renderRecent();toast('Activity log cleared.');}};
$('leadModal').addEventListener('click',e=>{if(e.target===$('leadModal'))closeModal();});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});
render();log('Workspace opened in local demo mode. No carrier connection configured.');
})();
</script>
</body>
</html>